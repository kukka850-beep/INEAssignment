# Supabase
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-side only, never expose to frontend

# Store target
STORE_BASE_URL=https://demo.inelabteamdev.com

# Server
PORT=4000
FRONTEND_ORIGIN=https://your-frontend.vercel.app

# Protects the /api/cron/run-scrapes endpoint from being hit by randoms.
# Set the same value in cron-job.org as a header or query param.
CRON_SECRET=change-me-to-a-long-random-string

# Scraper behaviour
SCRAPER_MODE=auto        # auto | http | browser  (see scraper/scraper.js)
SCRAPER_MAX_RETRIES=3
SCRAPER_TIMEOUT_MS=20000

# Optional bonus: email price-drop / back-in-stock alerts via SendGrid.
# Leave all three blank to disable — alerts still show up in-app either way.
SENDGRID_API_KEY=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
